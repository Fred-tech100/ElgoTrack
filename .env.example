# Copy to .env and fill in. Never commit .env.
# Development default only; set DEBUG=false before deploying.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://inventory.example.com
# Public address printed inside the verification QR codes on invoices and receipts
SITE_URL=https://inventory.example.com

# --- Database ---------------------------------------------------------------
# Local (non-Docker) run:
DATABASE_URL=postgres://elgonnova:password@localhost:5432/elgonnova
# Docker Compose builds DATABASE_URL itself from these:
POSTGRES_DB=elgonnova
POSTGRES_USER=elgonnova
POSTGRES_PASSWORD=change-me

# --- Cache / background jobs (Redis). Without it the app falls back to local memory and cron jobs. ---
REDIS_URL=

# --- Transactional email ---
# Development uses Django's console backend; production uses Brevo's HTTPS API.
EMAIL_PROVIDER=django
EMAIL_DELIVERY_MODE=celery
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@elgotrack.site
DEFAULT_FROM_NAME=ElgoTrack
BREVO_SENDER_EMAIL=no-reply@elgotrack.site
BREVO_SENDER_NAME=ElgoTrack
SUPPORT_EMAIL=support@elgotrack.site
ELGOTRACK_PUBLIC_URL=https://inventory.example.com
# Comma-separated: in_app (default), email
NOTIFICATION_CHANNELS=in_app

# --- Transport security ---
SECURE_SSL_REDIRECT=False
# Set false ONLY to test a deployment over plain HTTP before TLS is configured
SECURE_COOKIES=true
# Set true only when running behind a trusted reverse proxy
TRUST_X_FORWARDED_FOR=false

# --- Docker Compose extras ---
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONF=./deploy/nginx/nginx.conf
BACKUP_KEEP_DAYS=14
GUNICORN_WORKERS=
